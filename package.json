{
  "name": "mmm-art-studio",
  "version": "1.0.0",
  "description": "MMM Art Studio class booking system with a 7-stage Jenkins DevOps pipeline (SIT753 7.3HD)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test jest --ci",
    "test:unit": "NODE_ENV=test jest --ci tests/unit",
    "test:integration": "NODE_ENV=test jest --ci tests/integration"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "reports/coverage",
    "coverageReporters": [
      "text-summary",
      "lcov",
      "cobertura"
    ],
    "collectCoverageFrom": [
      "server.js",
      "notify.js",
      "scripts/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 60
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "author": "Nicolas Lai",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.0"
  }
}
